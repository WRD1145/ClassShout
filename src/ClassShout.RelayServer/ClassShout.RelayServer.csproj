<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    跨局域网中继服务器。

    部署在任意一台两端都能访问到的机器上（公网 VPS、学校内网服务器均可）。
    它只做转发和鉴权，不理解喊话内容 —— 音频对它是不可见的字节。

    运行：dotnet run 指定本项目，并用 urls 参数指定监听地址（如 http://0.0.0.0:8080）。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ClassShout.RelayServer</RootNamespace>
    <AssemblyName>ClassShout.RelayServer</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClassShout.Core\ClassShout.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      管理界面作为嵌入资源打进程序集，而不是放 wwwroot 走静态文件中间件：
      这样发布产物与运行目录无关，换工作目录、单文件发布都不会出现"页面 404"。

      HTML / CSS / JS 分成三个文件是安全要求，不是洁癖：
      控制台要下发 Content-Security-Policy，而 CSP 一旦收紧到 script-src 'self'，
      内联的 <script> 和内联事件处理器（onclick 之类）都会被浏览器拒绝执行。
      把脚本挪成独立文件，是这条策略能落地的前提。
    -->
    <EmbeddedResource Include="wwwroot\index.html" />
    <EmbeddedResource Include="wwwroot\app.css" />
    <EmbeddedResource Include="wwwroot\app.js" />
    <Content Remove="wwwroot\index.html;wwwroot\app.css;wwwroot\app.js" />
    <None Remove="wwwroot\index.html;wwwroot\app.css;wwwroot\app.js" />
  </ItemGroup>

</Project>
