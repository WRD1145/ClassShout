<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- 连接教室端 -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <!-- UDP 广播发现教室端需要 -->
  <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

  <!-- 语音喊话：运行时还需要动态申请，见 MainActivity -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" />

  <uses-feature android:name="android.hardware.microphone" android:required="true" />

  <!--
    Activity 与版本号等属性由构建系统根据 [Activity] 特性与 csproj 自动生成；
    这里只补权限、硬件特性，以及 Application 上那一个必须显式声明的属性。

    networkSecurityConfig 为什么非有不可：
    Android 从 targetSdk 28 起默认禁止明文 HTTP，而中继服务器允许是自带部署的
    http:// 地址。不开这一项，所有 http:// 的中继请求都会在连接阶段被系统拦掉，
    表现就是"填了地址、测试连接永远失败"。详见 Resources/xml/network_security_config.xml。
  -->
  <application android:networkSecurityConfig="@xml/network_security_config" />

</manifest>
