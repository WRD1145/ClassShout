<Project Sdk="Microsoft.NET.Sdk">

  <!-- 纯 .NET 库：协议、网络传输、音频抽象。不依赖 Avalonia，便于单测与复用。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ClassShout.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 读 Excel 名单（.xlsx/.xls）。老师手里的名单多半就是个表格，让他"先另存为 CSV"是多一道无用功。 -->
    <PackageReference Include="ExcelDataReader" Version="$(ExcelDataReaderVersion)" />
    <PackageReference Include="NLayer" Version="$(NLayerVersion)" />
  </ItemGroup>

</Project>
