<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:ClassShout.Teacher.Views"
        xmlns:vm="using:ClassShout.Teacher.ViewModels"
        x:Class="ClassShout.Teacher.Views.MainWindow"
        x:DataType="vm:TeacherShellViewModel"
        Title="ClassShout教师端"
        Width="1120" Height="820"
        MinWidth="720" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Md3.Surface}">

  <views:MainView />

</Window>
