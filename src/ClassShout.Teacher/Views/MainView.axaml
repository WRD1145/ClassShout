<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md3="using:ClassShout.Design.Controls"
             xmlns:vm="using:ClassShout.Teacher.ViewModels"
             xmlns:proto="using:ClassShout.Core.Protocol"
             xmlns:remote="using:ClassShout.Core.Remote"
             xmlns:design="using:ClassShout.Design"
             x:Class="ClassShout.Teacher.Views.MainView"
             x:DataType="vm:TeacherShellViewModel"
             Background="{DynamicResource Md3.Surface}">

  <!--
    带 x:Key 的 ControlTheme 是"资源"，必须放在 Resources 里；
    Styles 集合只接受不带 key 的 Style。放错位置编译器会直接报错。
  -->
  <UserControl.Resources>
    <ResourceDictionary>

      <!-- ==================== 底部导航项 ==================== -->
      <!--
        MD3 导航栏的选中态是"图标背后一个胶囊 + 图标文字变色"。
        这里用 RadioButton 实现：天然互斥，且 IsChecked 可以单向绑定到视图模型，
        点击后由命令改状态、状态再回流，方向和 MVVM 一致。
        文字标签走 Tag 传递，这样 Content 槽位留给图标。
      -->
      <ControlTheme x:Key="Md3NavItem" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource Md3.OnSurfaceVariant}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="Transparent" Padding="0,6">
              <StackPanel HorizontalAlignment="Center" Spacing="4">
                <Border Name="PART_Indicator"
                        CornerRadius="16" Padding="22,4"
                        HorizontalAlignment="Center"
                        Background="Transparent">
                  <ContentPresenter Name="PART_ContentPresenter"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Border>
                <TextBlock Name="PART_Label"
                           FontSize="12" FontWeight="{DynamicResource Md3.Weight.Emphasis}"
                           HorizontalAlignment="Center"
                           Text="{TemplateBinding Tag}" />
              </StackPanel>
            </Border>
          </ControlTemplate>
        </Setter>

        <Style Selector="^:checked">
          <Setter Property="Foreground" Value="{DynamicResource Md3.OnSecondaryContainer}" />
        </Style>
        <Style Selector="^:checked /template/ Border#PART_Indicator">
          <Setter Property="Background" Value="{DynamicResource Md3.SecondaryContainer}" />
        </Style>
      </ControlTheme>

    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- 小块标题：MD3 的 Label Medium，用弱化色 -->
    <Style Selector="TextBlock.cardTitle">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="{DynamicResource Md3.Weight.Emphasis}" />
      <Setter Property="Foreground" Value="{DynamicResource Md3.OnSurfaceVariant}" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <Grid RowDefinitions="Auto,Auto,*,Auto">

      <!-- ==================== 顶栏 ==================== -->
      <Border Grid.Row="0" Background="{DynamicResource Md3.SurfaceContainer}" Padding="20,14">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Width="42" Height="42" CornerRadius="13" Background="{DynamicResource Md3.Primary}">
            <md3:Md3Icon Kind="Bullhorn" Size="24" IconBrush="{DynamicResource Md3.OnPrimary}" />
          </Border>

          <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
            <TextBlock Classes="titleMedium" Text="ClassShout 教师端" />
            <TextBlock Classes="bodySmall"
                       Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding ConnectionStatusText}" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">

            <!-- 当前链路：局域网优先，只有直连不可用时才走公网中继 -->
            <Border IsVisible="{Binding IsConnected}"
                    CornerRadius="9999" Padding="10,5"
                    Background="{DynamicResource Md3.SecondaryContainer}">
              <TextBlock Classes="labelSmall"
                         Foreground="{DynamicResource Md3.OnSecondaryContainer}"
                         Text="{Binding ActiveLinkText}" />
            </Border>

            <Border IsVisible="{Binding IsClassroomMuted}"
                    CornerRadius="9999" Padding="10,5"
                    Background="{DynamicResource Md3.ErrorContainer}">
              <TextBlock Classes="labelSmall"
                         Foreground="{DynamicResource Md3.OnErrorContainer}"
                         Text="教室端已静音" />
            </Border>

            <Button Classes="icon" IsVisible="{Binding IsConnected}"
                    Command="{Binding DisconnectCommand}" ToolTip.Tip="断开连接">
              <md3:Md3Icon Kind="LinkOff" Size="22" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ==================== 错误提示条 ==================== -->
      <Border Grid.Row="1" IsVisible="{Binding HasError}"
              Background="{DynamicResource Md3.ErrorContainer}" Padding="20,12">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <md3:Md3Icon Kind="AlertCircle" Size="20" IconBrush="{DynamicResource Md3.OnErrorContainer}" />
          <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                     Foreground="{DynamicResource Md3.OnErrorContainer}"
                     Text="{Binding ErrorMessage}" />
        </StackPanel>
      </Border>

      <!-- ==================== 内容区 ==================== -->
      <Panel Grid.Row="2">

        <!-- ······ 文字喊话 ······ -->
        <!-- ==================== 学生名单 ==================== -->
        <ScrollViewer IsVisible="{Binding IsStudentsPage}">
          <StackPanel Margin="20,18" Spacing="18">

            <md3:Md3Card Classes="outlined" CardPadding="14">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="cardTitle" Text="学生名单" Margin="0" />
                  <TextBlock Grid.Column="1" Classes="bodySmall" VerticalAlignment="Center"
                             Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                             Text="{Binding RosterSummaryText}" />
                </Grid>

                <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="名单只存这台设备上 —— 它是你自己的备课资料，没有必要传到服务器上去。" />

                <ComboBox HorizontalAlignment="Stretch"
                          IsVisible="{Binding HasRosters}"
                          ItemsSource="{Binding Rosters}"
                          SelectedItem="{Binding ActiveRoster}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="remote:StudentRoster">
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasRosters}">
                  <Button Classes="outlined small" Content="删除这份名单"
                          Command="{Binding DeleteRosterCommand}" />
                </StackPanel>
              </StackPanel>
            </md3:Md3Card>

            <md3:Md3Card Classes="outlined" CardPadding="14">
              <StackPanel Spacing="10">
                <TextBlock Classes="cardTitle" Text="导入名单" />

                <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="每行一位学生：姓名,学号,简写,小组 —— 只有姓名是必填，后面三项留空就行。可以直接从 Excel 里复制粘贴，带表头也没关系。" />

                <TextBox Classes="outlined dense"
                         Watermark="这份名单叫什么（例如 三年二班）"
                         Text="{Binding RosterImportName}" />

                <TextBox Classes="outlined"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="140"
                         MaxHeight="240"
                         Watermark="张三,20250101,小张,A组&#x0a;李四,20250102,,B组&#x0a;王五"
                         Text="{Binding RosterImportText}" />

                <Button Classes="tonal block" Content="导入"
                        Command="{Binding ImportRosterCommand}" />

                <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="{Binding RosterHint}" />
              </StackPanel>
            </md3:Md3Card>

            <md3:Md3Card Classes="outlined" CardPadding="14" IsVisible="{Binding HasRosterStudents}">
              <StackPanel Spacing="10">
                <TextBlock Classes="cardTitle" Text="名单里的学生" />

                <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="点「叫这位」会把他填进「文字」页。要一次叫好几位，去「呼叫」页。" />

                <ItemsControl ItemsSource="{Binding RosterStudents}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StudentRow">
                      <Border CornerRadius="10" Margin="0,0,0,6" Padding="10"
                              Background="{DynamicResource Md3.SurfaceContainerHigh}">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="2">
                            <TextBlock Classes="bodyMedium" Text="{Binding Label}" />
                            <TextBlock Classes="bodySmall"
                                       Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                                       Text="{Binding GroupText, StringFormat='小组：{0}'}" />
                          </StackPanel>
                          <Button Grid.Column="1" Classes="tonal small" Content="叫这位"
                                  VerticalAlignment="Center"
                                  Command="{Binding UseCommand}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </md3:Md3Card>

          </StackPanel>
        </ScrollViewer>

        <!-- ==================== 快速呼叫 ==================== -->
        <ScrollViewer IsVisible="{Binding IsCallPage}">
          <StackPanel Margin="20,18" Spacing="18">

            <!-- 没有名单时先把人引到名单页：组件拼得再好，没有学生也发不出去 -->
            <md3:Md3Card Classes="outlined" CardPadding="14" IsVisible="{Binding Call.HasNoRoster}">
              <StackPanel Spacing="8">
                <TextBlock Classes="cardTitle" Text="先导入一份学生名单" />
                <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="呼叫页要用名单里的学生来拼句子。去「名单」页粘贴一份名单（从 Excel 直接复制就行），再回来。" />
                <Button Classes="tonal block" Content="去导入名单"
                        Command="{Binding NavigateStudentsCommand}" />
              </StackPanel>
            </md3:Md3Card>

            <!-- 模板 -->
            <md3:Md3Card Classes="outlined" CardPadding="14" IsVisible="{Binding Call.HasRoster}">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="cardTitle" Text="模板" Margin="0" />
                  <TextBlock Grid.Column="1" Classes="bodySmall" VerticalAlignment="Center"
                             Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                             Text="{Binding Call.RosterHint}" />
                </Grid>

                <ComboBox HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Call.TemplateChoices}"
                          SelectedItem="{Binding Call.SelectedTemplate}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:TemplateChoice">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBox Classes="outlined dense"
                         Watermark="模板名（例如 来办公室）"
                         Text="{Binding Call.TemplateName}" />

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                  <Button Grid.Column="0" Classes="tonal" Content="保存模板"
                          Command="{Binding Call.SaveTemplateCommand}" />
                  <Button Grid.Column="1" Classes="outlined" Content="新建"
                          Command="{Binding Call.NewTemplateCommand}" />
                  <Button Grid.Column="2" Classes="outlined" Content="删除"
                          Command="{Binding Call.DeleteTemplateCommand}" />
                </Grid>
              </StackPanel>
            </md3:Md3Card>

            <!-- 组件面板：点一下加进去，也可以拖到下面的拼装区 -->
            <md3:Md3Card Classes="outlined" CardPadding="14" IsVisible="{Binding Call.HasRoster}">
              <StackPanel Spacing="10">
                <TextBlock Classes="cardTitle" Text="组件" />

                <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="点一下加到拼装区，或者直接拖过去。空格与标点由「文字」组件自己带 —— 想要「张三 来 数学张老师」就在文字里写「 来 」。" />

                <ItemsControl ItemsSource="{Binding Call.ComponentPalette}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ComponentPaletteItem">
                      <Button Classes="tonal small" Margin="0,0,8,8"
                              Content="{Binding Label}"
                              PointerPressed="OnPalettePointerPressed"
                              Command="{Binding $parent[ItemsControl].((vm:TeacherShellViewModel)DataContext).Call.AddComponentCommand}"
                              CommandParameter="{Binding Kind}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </md3:Md3Card>

            <!-- 拼装区 -->
            <md3:Md3Card Classes="outlined" CardPadding="14" IsVisible="{Binding Call.HasRoster}">
              <StackPanel Spacing="10">
                <TextBlock Classes="cardTitle" Text="拼装区（拖到这里）" />

                <Border Name="CallComposer" MinHeight="90" CornerRadius="12" Padding="10"
                        DragDrop.AllowDrop="True"
                        Background="{DynamicResource Md3.SurfaceContainerHigh}">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="bodySmall"
                               Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                               IsVisible="{Binding !Call.HasComponents}"
                               Text="还是空的 —— 从上面点或拖一个组件进来。" />

                    <ItemsControl ItemsSource="{Binding Call.Components}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ComponentRow">
                          <Border CornerRadius="10" Margin="0,0,0,6" Padding="8"
                                  Background="{DynamicResource Md3.SurfaceContainerLowest}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                              <TextBlock Classes="labelMedium" VerticalAlignment="Center"
                                         Text="{Binding Label}" />
                              <TextBox Grid.Column="1" Classes="outlined dense" Margin="8,0"
                                       IsVisible="{Binding IsText}"
                                       Watermark="文字"
                                       Text="{Binding Text}" />
                              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                                <Button Classes="icon" Command="{Binding MoveLeftCommand}" ToolTip.Tip="左移">
                                  <md3:Md3Icon Kind="ArrowLeft" Size="16" />
                                </Button>
                                <Button Classes="icon" Command="{Binding MoveRightCommand}" ToolTip.Tip="右移">
                                  <md3:Md3Icon Kind="ArrowRight" Size="16" />
                                </Button>
                                <Button Classes="icon" Command="{Binding RemoveCommand}" ToolTip.Tip="移除">
                                  <md3:Md3Icon Kind="Close" Size="16" />
                                </Button>
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <Border Background="{DynamicResource Md3.SurfaceContainerHighest}"
                        CornerRadius="10" Padding="12,10">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="labelSmall"
                               Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                               Text="预览" />
                    <TextBlock Classes="bodyLarge" TextWrapping="Wrap"
                               Text="{Binding Call.PreviewText}" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </md3:Md3Card>

            <!-- 选学生 -->
            <md3:Md3Card Classes="outlined" CardPadding="14" IsVisible="{Binding Call.HasRoster}">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="cardTitle" Text="叫谁" Margin="0" />
                  <TextBlock Grid.Column="1" Classes="bodySmall" VerticalAlignment="Center"
                             Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                             Text="{Binding Call.PickedSummary}" />
                </Grid>

                <StackPanel Spacing="6">
                  <TextBlock Classes="bodySmall"
                             Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                             Text="列表里按哪种标识显示（只有填过的学生才会出现在这一档里）" />
                  <ComboBox HorizontalAlignment="Stretch"
                            ItemsSource="{Binding Call.LabelStyles}"
                            SelectedItem="{Binding Call.SelectedLabelStyle}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:StudentLabelChoice">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Call.HasGroups}">
                  <TextBlock Classes="bodySmall" VerticalAlignment="Center"
                             Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                             Text="按小组叫：" />
                  <ItemsControl ItemsSource="{Binding Call.Groups}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Button Classes="tonal small" Margin="0,0,6,0" Content="{Binding}"
                                Command="{Binding $parent[ItemsControl].((vm:TeacherShellViewModel)DataContext).Call.PickGroupCommand}"
                                CommandParameter="{Binding}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Call.Students}" MaxHeight="320">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StudentPickRow">
                      <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,2">
                        <CheckBox IsChecked="{Binding IsSelected}"
                                  IsEnabled="{Binding IsSelectable}"
                                  VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="1" Margin="4,0,0,0">
                          <TextBlock Classes="bodyMedium" Text="{Binding Display}" />
                          <TextBlock Classes="bodySmall"
                                     Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                                     Text="{Binding Detail}" />
                          <TextBlock Classes="bodySmall"
                                     Foreground="{DynamicResource Md3.Error}"
                                     Text="{Binding UnavailableHint}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <Button Grid.Column="0" Classes="outlined" Content="清空选择"
                          Command="{Binding Call.ClearPicksCommand}" />
                  <Button Grid.Column="1" Classes="block" Content="呼叫"
                          Command="{Binding Call.SendCallCommand}" />
                </Grid>

                <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="{Binding Call.StatusHint}" />
              </StackPanel>
            </md3:Md3Card>

          </StackPanel>
        </ScrollViewer>

        <ScrollViewer IsVisible="{Binding IsTextPage}">
          <StackPanel Margin="20,18" Spacing="18">

            <md3:Md3Card Classes="outlined" CardPadding="14">
              <StackPanel Spacing="10">
                <TextBlock Classes="cardTitle" Text="要对教室说的话" />
                <TextBox Classes="outlined"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="120"
                         MaxHeight="220"
                         Watermark="例如：同学们请安静，现在讲第三题"
                         Text="{Binding Text.Text}" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="bodySmall"
                             Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                             Text="{Binding Text.CharacterCountText}" />
                  <Button Grid.Column="1" Classes="text small" Content="清空"
                          Command="{Binding Text.ClearCommand}" />
                </Grid>

                <!-- 随图一起喊。图片和文字是同一次喊话，所以它就挂在输入框这张卡里。 -->
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"
                        IsVisible="{Binding Text.HasImage}">
                    <Border CornerRadius="10" ClipToBounds="True"
                            Background="{DynamicResource Md3.SurfaceContainerHigh}">
                      <Image Source="{Binding Text.ImagePreview}" Stretch="Uniform"
                             Width="96" Height="96" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                      <TextBlock Classes="bodyMedium" Text="图片会随这条一起发出去" />
                      <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                                 Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                                 Text="{Binding Text.ImageSizeText}" />
                      <Button Classes="text small" HorizontalAlignment="Left"
                              Content="移除图片"
                              Command="{Binding Text.ClearImageCommand}" />
                    </StackPanel>
                  </Grid>

                  <Button Classes="tonal block" Click="OnPickImageClick">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                      <md3:Md3Icon Kind="ImagePlus" Size="18" />
                      <TextBlock Text="选择图片" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>
            </md3:Md3Card>

            <!-- 发给谁：只保存了一间教室时整块不显示（只有一间的话，"选择"没有意义） -->
            <md3:Md3Card Classes="outlined" CardPadding="14" IsVisible="{Binding Text.HasMultipleTargets}">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="cardTitle" Text="这条发给谁" Margin="0" />
                  <TextBlock Grid.Column="1" Classes="bodySmall" VerticalAlignment="Center"
                             Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                             Text="{Binding Text.TargetSummaryText}" />
                </Grid>

                <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="勾选多个班级时，这一条会同时发到每一间（经中继服务器）。语音喊话不受影响，仍然只发当前绑定的那间 —— 声音是从某一个教室的喇叭出来的，同时往几个班播没有意义。" />

                <ItemsControl ItemsSource="{Binding Text.Targets}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ShoutTargetItem">
                      <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Classes="bodyMedium" Margin="6,0,0,0"
                                   VerticalAlignment="Center" Text="{Binding Name}" />
                        <Border Grid.Column="2" IsVisible="{Binding IsCurrent}"
                                CornerRadius="9999" Padding="7,1" VerticalAlignment="Center"
                                Background="{DynamicResource Md3.PrimaryContainer}">
                          <TextBlock Classes="labelSmall"
                                     Foreground="{DynamicResource Md3.OnPrimaryContainer}"
                                     Text="当前绑定" />
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </md3:Md3Card>

            <md3:Md3Card Classes="outlined" CardPadding="14">
              <StackPanel Spacing="12">
                <TextBlock Classes="cardTitle" Text="这条怎么显示" />

                <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="{Binding Text.DisplaySummaryText}" />

                <StackPanel Spacing="4">
                  <TextBlock Classes="bodyMedium" Text="展示方式" />
                  <ComboBox HorizontalAlignment="Stretch"
                            ItemsSource="{Binding Text.DisplayOptions}"
                            SelectedItem="{Binding Text.SelectedDisplay}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="proto:ShoutDisplayOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="bodyMedium" Text="文字大小" />
                    <ComboBox HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Text.FontSizeOptions}"
                              SelectedItem="{Binding Text.SelectedFontSize}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="proto:ShoutFontSizeOption">
                          <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>

                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Classes="bodyMedium" Text="停留时间" />
                    <ComboBox HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Text.HoldOptions}"
                              SelectedItem="{Binding Text.SelectedHold}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="proto:ShoutHoldOption">
                          <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="bodyMedium" Text="语音播报" />
                    <TextBlock Classes="bodySmall"
                               Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                               Text="关掉就只把字摆出来，不打断讲解" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                IsChecked="{Binding Text.Speak}" />
                </Grid>

                <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="这几个选项只影响这一条，选完会记住，下次打开还是它。教室端自己还有一套「没人指定时用哪一档」的默认值。" />
              </StackPanel>
            </md3:Md3Card>

            <!-- 发送：这一页最要紧的那个动作。
                 原来这一页压根没有发送按钮（命令在视图模型里躺着、界面上没有入口），
                 于是文字喊话只能靠"呼叫"页或语音页发出去 —— 所以它单独占一张卡。 -->
            <md3:Md3Card Classes="outlined" CardPadding="14">
              <StackPanel Spacing="10">
                <Button Classes="block" HorizontalContentAlignment="Center"
                        Command="{Binding Text.SendCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <md3:Md3Icon Kind="Send" Size="18" />
                    <TextBlock Text="发送到教室" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>

                <!-- 灰着就说清为什么灰：没连教室、还没写内容、上一条还在发 -->
                <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                           IsVisible="{Binding Text.HasSendBlockedHint}"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="{Binding Text.SendBlockedHint}" />

                <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                           IsVisible="{Binding Text.IsQueued}"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="{Binding Text.QueueStatus}" />
              </StackPanel>
            </md3:Md3Card>

            <!-- 定时通知：把当前这条排到某个时间自动发出去。
                 可靠性边界写在卡片上，而不是只写在文档里 ——
                 老师会照着界面上的字去预期行为。 -->
            <md3:Md3Card Classes="outlined" CardPadding="14">
              <StackPanel Spacing="12">
                <TextBlock Classes="cardTitle" Text="定时通知" />

                <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="{Binding ScheduleHintText}" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="bodySmall"
                               Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                               Text="日期" />
                    <DatePicker HorizontalAlignment="Stretch" SelectedDate="{Binding ScheduleDate}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Classes="bodySmall"
                               Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                               Text="时间" />
                    <TimePicker HorizontalAlignment="Stretch" SelectedTime="{Binding ScheduleTime}" />
                  </StackPanel>
                </Grid>

                <Button Classes="tonal block" HorizontalContentAlignment="Center"
                        Command="{Binding ScheduleShoutCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <md3:Md3Icon Kind="ClockPlusOutline" Size="18" />
                    <TextBlock Text="把这条排进定时" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>

                <!-- 定时语音：录一段存下来，到点当作语音喊话放出去。
                     与语音页的"按住说话"不同 —— 这里不边录边发，而是先攒着。 -->
                <StackPanel Spacing="8" IsVisible="{Binding IsRecordingClipVisible}">
                  <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                             Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                             Text="也可以排一段语音：录好之后选个时间，到点教室会放出来。" />

                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Button Classes="outlined" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Command="{Binding ToggleClipRecordingCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <md3:Md3Icon Kind="Microphone" Size="18" />
                        <TextBlock Text="{Binding ScheduleVoiceButtonText}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <TextBlock Grid.Column="1" Classes="bodyMedium" VerticalAlignment="Center"
                               Text="{Binding ClipElapsedText}" />
                  </Grid>

                  <ProgressBar IsVisible="{Binding IsRecordingClip}"
                               Minimum="0" Maximum="1" Value="{Binding ClipLevel}" />

                  <StackPanel Spacing="6" IsVisible="{Binding HasPendingClip}">
                    <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                               Foreground="{DynamicResource Md3.Primary}"
                               Text="{Binding PendingClipText}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="tonal small" Content="把这段语音排进定时"
                              Command="{Binding ScheduleVoiceClipCommand}" />
                      <Button Classes="text small" Content="重录"
                              Command="{Binding DiscardClipCommand}" />
                    </StackPanel>
                  </StackPanel>

                  <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                             IsVisible="{Binding ClipStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                             Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                             Text="{Binding ClipStatus}" />
                </StackPanel>

                <StackPanel Spacing="6" IsVisible="{Binding HasScheduledShouts}">
                  <TextBlock Classes="bodySmall"
                             Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                             Text="待发送" />
                  <ItemsControl ItemsSource="{Binding ScheduledShouts}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ScheduledShoutItem">
                        <Border CornerRadius="10" Margin="0,0,0,6" Padding="10"
                                Background="{DynamicResource Md3.SurfaceContainerHigh}">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                              <TextBlock Classes="bodyMedium" Text="{Binding TimeText}" />
                              <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                                         Text="{Binding SummaryText}" />
                              <TextBlock Classes="bodySmall"
                                         Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                                         Text="{Binding TargetText, StringFormat='发给：{0}'}" />
                              <TextBlock Classes="bodySmall"
                                         Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                                         Text="{Binding DisplayText}" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="text small" Content="取消"
                                    VerticalAlignment="Center"
                                    Command="{Binding CancelCommand}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </md3:Md3Card>

            <md3:Md3Card Classes="outlined" CardPadding="14">
              <StackPanel Spacing="12">
                <TextBlock Classes="cardTitle" Text="朗读参数（教室端生效）" />

                <StackPanel Spacing="4">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="bodyMedium" Text="语速" />
                    <TextBlock Grid.Column="1" Classes="bodyMedium"
                               Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                               Text="{Binding Text.RateText}" />
                  </Grid>
                  <Slider Minimum="-6" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True"
                          Value="{Binding Text.Rate}" />
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="bodyMedium" Text="打断当前朗读" />
                    <TextBlock Classes="bodySmall"
                               Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                               Text="关闭后，新内容会等前一条读完" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                IsChecked="{Binding Text.Interrupt}" />
                </Grid>
              </StackPanel>
            </md3:Md3Card>

            <!-- 常用语：默认给几句通用的，但每位老师的话不一样，所以能自己增删改 -->
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="cardTitle" Text="常用语" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="text small" Content="编辑"
                        IsVisible="{Binding !Text.IsEditingPresets}"
                        Command="{Binding Text.BeginEditPresetsCommand}" />
                <Button Grid.Column="1" Classes="tonal small" Content="完成"
                        IsVisible="{Binding Text.IsEditingPresets}"
                        Command="{Binding Text.FinishEditPresetsCommand}" />
              </Grid>

              <!-- 平时：点一下填进输入框 -->
              <ItemsControl ItemsSource="{Binding Text.Presets}"
                            IsVisible="{Binding !Text.IsEditingPresets}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TextPreset">
                    <Button Classes="tonal small" Margin="0,0,8,8"
                            Content="{Binding Text}"
                            Command="{Binding ApplyCommand}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                         IsVisible="{Binding !Text.IsEditingPresets}"
                         Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                         Text="这些话是通用的默认值。想换成自己天天说的那几句，点右上角「编辑」。" />

              <!-- 编辑：每行一个输入框，改完点「完成」才落盘 -->
              <StackPanel Spacing="8" IsVisible="{Binding Text.IsEditingPresets}">
                <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                           IsVisible="{Binding Text.HasNoPresets}"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="一条都没有 —— 点「新增一条」，或者「恢复默认」拿回出厂那几句。" />

                <ItemsControl ItemsSource="{Binding Text.Presets}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TextPreset">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBox Classes="outlined dense"
                                 MaxLength="{x:Static remote:TeacherPhraseSettings.MaxLength}"
                                 Watermark="常用语"
                                 Text="{Binding Text}" />
                        <Button Grid.Column="1" Classes="icon" Margin="4,0,0,0"
                                Command="{Binding RemoveCommand}"
                                ToolTip.Tip="删掉这一条">
                          <md3:Md3Icon Kind="DeleteOutline" Size="18" />
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="tonal small" Content="新增一条"
                          Command="{Binding Text.AddPresetCommand}" />
                  <Button Classes="outlined small" Content="恢复默认"
                          Command="{Binding Text.ResetPresetsCommand}" />
                </StackPanel>

                <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="{Binding Text.PresetLimitText}" />
              </StackPanel>

              <!-- 存好了 / 到上限了这类回执：不提示的话，"到底存没存"只能靠下次打开猜 -->
              <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                         IsVisible="{Binding Text.PresetStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         Foreground="{DynamicResource Md3.Primary}"
                         Text="{Binding Text.PresetStatus}" />
            </StackPanel>

            <!-- 排队状态：连着发好几条时，老师需要知道"我这条前面还有几个" -->
            <Border IsVisible="{Binding Text.QueueStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Background="{DynamicResource Md3.SecondaryContainer}"
                    CornerRadius="10" Padding="12,9">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <md3:Md3Icon Kind="PlaylistPlay" Size="18" Classes="secondary" />
                <TextBlock Classes="bodySmall" VerticalAlignment="Center"
                           Foreground="{DynamicResource Md3.OnSecondaryContainer}"
                           Text="{Binding Text.QueueStatus}" />
              </StackPanel>
            </Border>

            <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                       Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                       Text="文字会发送到教室端，由教室电脑的系统语音朗读 —— 声音从教室音响出来，手机本身不发声。连发多条会按发出的先后排队。" />

          </StackPanel>
        </ScrollViewer>

        <!-- ······ 语音喊话 ······ -->
        <Grid IsVisible="{Binding IsVoicePage}" RowDefinitions="Auto,*,Auto" Margin="20,18">

          <StackPanel Grid.Row="0" Spacing="6" HorizontalAlignment="Center">
            <TextBlock Classes="titleMedium" HorizontalAlignment="Center"
                       Text="{Binding Voice.TitleText}" />
            <TextBlock Classes="bodySmall" HorizontalAlignment="Center"
                       Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                       Text="{Binding Voice.FormatText}" />

            <!-- 录音失败时必须让用户看见原因（缺权限、麦克风被占用等） -->
            <Border IsVisible="{Binding Voice.HasError}"
                    Background="{DynamicResource Md3.ErrorContainer}"
                    CornerRadius="10" Padding="12,8"
                    MaxWidth="340" Margin="0,8,0,0">
              <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                         Foreground="{DynamicResource Md3.OnErrorContainer}"
                         Text="{Binding Voice.ErrorMessage}" />
            </Border>
          </StackPanel>

          <!-- 波形 -->
          <Border Grid.Row="1" VerticalAlignment="Center" Height="120"
                  Background="{DynamicResource Md3.SurfaceContainerHigh}"
                  CornerRadius="20" Padding="18">
            <md3:Md3AudioWave Height="84"
                              BarBrush="{DynamicResource Md3.Primary}"
                              Level="{Binding Voice.Level}" />
          </Border>

          <!-- 录音按钮 -->
          <StackPanel Grid.Row="2" Spacing="16" HorizontalAlignment="Center">
            <TextBlock Classes="headlineSmall" HorizontalAlignment="Center"
                       Text="{Binding Voice.ElapsedText}" />

            <Button Width="132" Height="132" Padding="0"
                    HorizontalAlignment="Center"
                    Classes.recording="{Binding Voice.IsRecording}"
                    Command="{Binding Voice.ToggleCommand}">
              <Panel>
                <md3:Md3Icon Kind="Microphone" Size="52"
                             IsVisible="{Binding !Voice.IsRecording}"
                             IconBrush="{DynamicResource Md3.OnPrimary}" />
                <md3:Md3Icon Kind="Send" Size="52"
                             IsVisible="{Binding Voice.IsRecording}"
                             IconBrush="{DynamicResource Md3.OnError}" />
              </Panel>
            </Button>

            <TextBlock Classes="bodySmall" HorizontalAlignment="Center" TextAlignment="Center"
                       MaxWidth="260" TextWrapping="Wrap"
                       Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                       Text="点一下开始，再点一下结束并发送" />

            <Button Classes="text" HorizontalAlignment="Center" Content="放弃本次录音"
                    IsVisible="{Binding Voice.IsRecording}"
                    Command="{Binding Voice.CancelCommand}" />
          </StackPanel>
        </Grid>

        <!-- ······ 设备与连接 ······ -->
        <ScrollViewer IsVisible="{Binding IsDevicesPage}">
          <StackPanel Margin="20,18" Spacing="18">

            <md3:Md3Card Classes="outlined" CardPadding="14">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="cardTitle" Text="自动发现" />
                    <TextBlock Classes="bodySmall"
                               Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                               Text="同一 Wi-Fi 下会列出所有教室端" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="tonal small"
                          Command="{Binding ScanCommand}"
                          IsEnabled="{Binding !IsScanning}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <md3:Md3Icon Kind="Radar" Size="16" />
                      <TextBlock Text="扫描" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Grid>

                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsScanning}" />

                <TextBlock Classes="bodyMedium" IsVisible="{Binding !HasClassrooms}"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="尚未发现教室端，点上面的「扫描」试试。" />

                <ItemsControl ItemsSource="{Binding Classrooms}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ClassroomListItem">
                      <Button Classes="outlined block" Margin="0,0,0,8"
                              HorizontalContentAlignment="Left"
                              Command="{Binding ConnectCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                          <md3:Md3Icon Kind="School" Size="22" />
                          <StackPanel>
                            <TextBlock Classes="bodyLarge" Text="{Binding Name}" />
                            <TextBlock Classes="bodySmall"
                                       Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                                       Text="{Binding Subtitle}" />
                          </StackPanel>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </md3:Md3Card>

            <!-- ==================== 同一局域网：直接用，不需要账号 ==================== -->
            <md3:Md3Card Classes="outlined" CardPadding="14">
              <StackPanel Spacing="12">
                <TextBlock Classes="cardTitle" Text="手动连接" />
                <TextBox Classes="outlined"
                         Watermark="192.168.1.5:45900"
                         Text="{Binding ManualAddress}" />
                <Button Classes="block" Content="连接"
                        Command="{Binding ConnectManualCommand}" />
                <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="教室端启动后，顶栏会显示它自己的地址，按那个填即可。" />
              </StackPanel>
            </md3:Md3Card>

            <!--
              服务器地址单独一张卡片，独立于登录与绑定。

              它原本和「教室 UUID / 口令」挤在同一张卡里，而且把地址写进配置的唯一路径是
              「绑定教室」—— 绑定又要求已登录，登录读的却正是那个还没写进去的地址。
              新装的机器因此死锁：登录提示"请先填写服务器地址"（尽管地址框里刚填了），
              而能让地址生效的那个按钮永远点不亮。

              地址属于"我的账号在哪台服务器上"，层级高于"绑了哪间教室"，本就该是单独一步。
            -->
            <md3:Md3Card Classes="outlined" CardPadding="14">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="cardTitle" Text="中继服务器" Margin="0" />
                  <Border Grid.Column="1" CornerRadius="9999" Padding="9,3"
                          Background="{DynamicResource Md3.SecondaryContainer}">
                    <TextBlock Classes="labelSmall"
                               Foreground="{DynamicResource Md3.OnSecondaryContainer}"
                               Text="{Binding ServerAddressPill}" />
                  </Border>
                </Grid>

                <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="与教室不在同一网络时用这个：两端接到同一台中继服务器即可，地址由部署服务器的人提供。只用同一网段内的教室时不必配置，直接在上面「手动连接」里连。" />

                <TextBox Classes="outlined dense"
                         Watermark="https://relay.example.com 或 http://192.168.1.10:8080"
                         Text="{Binding ServerUrl}" />

                <!--
                  刻意不写 IsEnabled：按钮的可用性由命令的 CanExecute 决定（含"输入为空"与"正在执行"两种）。
                  再写一条 IsEnabled 绑定等于给同一件事设两个来源，两个都得为真按钮才亮 ——
                  排查起来会以为是绑定的问题，实际是命令那道闸门。
                -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <Button Grid.Column="0" Classes="block" Content="保存地址"
                          Command="{Binding SaveServerAddressCommand}" />
                  <Button Grid.Column="1" Classes="outlined block" Content="测试连接"
                          Command="{Binding TestServerCommand}" />
                </Grid>

                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsServerAddressBusy}" />

                <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="{Binding ServerAddressStatus}" />

                <Border IsVisible="{Binding HasServerAddressError}"
                        Background="{DynamicResource Md3.ErrorContainer}"
                        CornerRadius="10" Padding="10,8">
                  <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                             Foreground="{DynamicResource Md3.OnErrorContainer}"
                             Text="{Binding ServerAddressError}" />
                </Border>

                <Border IsVisible="{Binding HasServerAddressNotice}"
                        Background="{DynamicResource Md3.SecondaryContainer}"
                        CornerRadius="10" Padding="10,8">
                  <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                             Foreground="{DynamicResource Md3.OnSecondaryContainer}"
                             Text="{Binding ServerAddressNotice}" />
                </Border>

                <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="换服务器等于换一整套账号与绑定关系，所以改地址会解除原有登录与教室绑定。" />
              </StackPanel>
            </md3:Md3Card>

            <!-- ==================== 账号 ==================== -->
            <md3:Md3Card Classes="outlined" CardPadding="14">
              <StackPanel Spacing="12">

                <!-- 已登录 -->
                <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsSignedIn}">
                  <Border Width="44" Height="44" CornerRadius="22"
                          Background="{DynamicResource Md3.PrimaryContainer}">
                    <md3:Md3Icon Kind="Account" Size="24"
                                 IconBrush="{DynamicResource Md3.OnPrimaryContainer}" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="titleMedium" Text="{Binding SignedInName}" />
                    <TextBlock Classes="bodySmall"
                               Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                               Text="{Binding AccountLabel}" />
                  </StackPanel>
                  <Button Grid.Column="2" Classes="outlined small" Content="退出"
                          VerticalAlignment="Center"
                          Command="{Binding LogoutCommand}" />
                </Grid>

                <!-- 未登录 -->
                <StackPanel Spacing="12" IsVisible="{Binding !IsSignedIn}">
                  <TextBlock Classes="cardTitle" Text="登录后喊话会带上你的姓名" />

                  <StackPanel Spacing="10" IsVisible="{Binding !IsRegisterMode}">
                    <TextBox Classes="outlined dense"
                             Watermark="用户名或邮箱"
                             Text="{Binding LoginAccount}" />
                    <TextBox Classes="outlined dense"
                             Watermark="口令"
                             PasswordChar="●"
                             Text="{Binding LoginPassword}" />
                    <Button Classes="block" Content="登录"
                            Command="{Binding LoginCommand}" />
                  </StackPanel>

                  <StackPanel Spacing="10" IsVisible="{Binding IsRegisterMode}">
                    <TextBox Classes="outlined dense"
                             Watermark="用户名（3~20 位，字母开头）"
                             Text="{Binding RegisterUsername}" />
                    <TextBox Classes="outlined dense"
                             Watermark="邮箱"
                             Text="{Binding RegisterEmail}" />
                    <TextBox Classes="outlined dense"
                             Watermark="姓名（学生看到的就是它）"
                             Text="{Binding RegisterDisplayName}" />
                    <TextBox Classes="outlined dense"
                             Watermark="任教科目（选填，例如 数学）"
                             Text="{Binding RegisterSubject}" />
                    <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                               Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                               Text="填了科目，教室里看到的来源就是「数学张老师」—— 同一间教室一天里有好几位老师来喊，只报姓名往往对不上人。" />
                    <TextBox Classes="outlined dense"
                             Watermark="口令（至少 6 位）"
                             PasswordChar="●"
                             Text="{Binding RegisterPassword}" />
                    <Button Classes="block" Content="注册并登录"
                            Command="{Binding RegisterCommand}" />
                  </StackPanel>

                  <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                             Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                             Text="{Binding AccountModeHint}" />

                  <Button Classes="text small" HorizontalAlignment="Left"
                          Command="{Binding ToggleAccountModeCommand}">
                    <TextBlock Text="{Binding AccountToggleText}" />
                  </Button>

                  <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsAccountBusy}" />

                  <Border IsVisible="{Binding HasAccountError}"
                          Background="{DynamicResource Md3.ErrorContainer}"
                          CornerRadius="10" Padding="10,8">
                    <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                               Foreground="{DynamicResource Md3.OnErrorContainer}"
                               Text="{Binding AccountError}" />
                  </Border>

                  <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                             Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                             Text="登录只在使用「跨局域网」时需要，而且要先用上面的「中继服务器」配好地址；只连同一局域网内的教室不必登录。" />
                </StackPanel>
              </StackPanel>
            </md3:Md3Card>

            <!-- ==================== 管理员已授权的教室 ==================== -->
            <md3:Md3Card Classes="outlined" CardPadding="14" IsVisible="{Binding HasAuthorizedClassrooms}">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="cardTitle" Text="管理员分配的班级" Margin="0" />
                    <TextBlock Classes="bodySmall"
                               Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                               Text="这些班级已由管理员授权给你，点一下即可绑定，无需填写口令" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="text small" Content="刷新"
                          Command="{Binding RefreshAuthorizedCommand}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding AuthorizedClassrooms}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ClassroomGrantItem">
                      <Button Classes="tonal block" Margin="0,0,0,8"
                              HorizontalContentAlignment="Left"
                              IsEnabled="{Binding !$parent[ItemsControl].((vm:TeacherShellViewModel)DataContext).IsServerBusy}"
                              Command="{Binding BindCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                          <md3:Md3Icon Kind="School" Size="22" />
                          <StackPanel Spacing="1">
                            <TextBlock Classes="bodyLarge" Text="{Binding Name}" />
                            <TextBlock Classes="bodySmall"
                                       Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                                       Text="{Binding StatusText}" />
                          </StackPanel>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsServerBusy}" />
              </StackPanel>
            </md3:Md3Card>

            <!-- ==================== 跨局域网绑定 ==================== -->
            <md3:Md3Card Classes="outlined" CardPadding="14">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="cardTitle" Text="绑定教室（跨局域网）" Margin="0" />
                  <Border Grid.Column="1" CornerRadius="9999" Padding="9,3"
                          Background="{DynamicResource Md3.SecondaryContainer}">
                    <TextBlock Classes="labelSmall"
                               Foreground="{DynamicResource Md3.OnSecondaryContainer}"
                               Text="{Binding ServerStatusText}" />
                  </Border>
                </Grid>

                <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="向教室管理员索取 UUID 与口令。服务器地址在上面那张「中继服务器」卡片里单独配置 —— 这里只填「哪间教室」。绑定过的教室会存在本机，之后在下面点一下就能切过去。" />

                <TextBox Classes="outlined dense"
                         Watermark="教室 UUID"
                         FontFamily="Consolas, monospace"
                         Text="{Binding BindUuid}" />

                <TextBox Classes="outlined dense"
                         Watermark="教室口令（Secret）"
                         PasswordChar="●"
                         Text="{Binding BindSecret}" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <Button Grid.Column="0" Classes="block" Content="绑定教室"
                          IsEnabled="{Binding !IsServerBound}"
                          Command="{Binding BindServerCommand}" />
                  <Button Grid.Column="1" Classes="outlined block" Content="解除绑定"
                          IsEnabled="{Binding IsServerBound}"
                          Command="{Binding UnbindServerCommand}" />
                </Grid>

                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsServerBusy}" />

                <Border IsVisible="{Binding HasServerError}"
                        Background="{DynamicResource Md3.ErrorContainer}"
                        CornerRadius="10" Padding="10,8">
                  <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                             Foreground="{DynamicResource Md3.OnErrorContainer}"
                             Text="{Binding ServerError}" />
                </Border>

                <!-- 已保存的教室：点一下切过去，右边的 × 把它连同口令一起删掉 -->
                <StackPanel Spacing="6" IsVisible="{Binding HasSavedClassrooms}">
                  <TextBlock Classes="bodySmall"
                             Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                             Text="已保存的教室" />
                  <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                             Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                             Text="{Binding SavedClassroomsHint}" />
                  <ItemsControl ItemsSource="{Binding SavedClassrooms}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SavedClassroomItem">
                        <Border CornerRadius="10" Margin="0,0,0,6" Padding="4"
                                Background="{DynamicResource Md3.SurfaceContainerHigh}">
                          <Grid ColumnDefinitions="*,Auto">
                            <Button Classes="text small" Padding="8,6"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    IsEnabled="{Binding !IsCurrent}"
                                    Command="{Binding SwitchCommand}">
                              <StackPanel Spacing="1">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                  <TextBlock Classes="bodyMedium" Text="{Binding Name}" />
                                  <!-- 当前这间标出来：切换教室里最要紧的信息就是"我现在喊的是哪个班" -->
                                  <Border IsVisible="{Binding IsCurrent}"
                                          CornerRadius="9999" Padding="7,1"
                                          VerticalAlignment="Center"
                                          Background="{DynamicResource Md3.PrimaryContainer}">
                                    <TextBlock Classes="labelSmall"
                                               Foreground="{DynamicResource Md3.OnPrimaryContainer}"
                                               Text="使用中" />
                                  </Border>
                                </StackPanel>
                                <TextBlock Classes="bodySmall"
                                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                                           Text="{Binding DetailText}" />
                              </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Classes="icon" Margin="4,0,0,0"
                                    Command="{Binding RemoveCommand}"
                                    ToolTip.Tip="从列表里移除（连同保存的口令）">
                              <md3:Md3Icon Kind="DeleteOutline" Size="18" />
                            </Button>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </md3:Md3Card>

            <!-- ==================== 任教科目（按班级） ==================== -->
            <!--
              同一位老师在不同班可能教不同科目（信息技术老师顺手给一个班带数学），
              所以默认科目之外还要能按班级各填一份。教室里看到的来源
              （"数学张老师"／"信息技术张老师"）跟着那条喊话要去的班走。
            -->
            <md3:Md3Card Classes="outlined" CardPadding="14">
              <StackPanel Spacing="10">
                <TextBlock Classes="cardTitle" Text="任教科目" />

                <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="{Binding SubjectHintText}" />

                <TextBox Classes="outlined dense"
                         Watermark="默认科目，例如 数学"
                         Text="{Binding DefaultSubject}" />

                <StackPanel Spacing="6" IsVisible="{Binding HasSubjectRows}">
                  <TextBlock Classes="bodySmall"
                             Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                             Text="个别班级不一样就填在这里（留空＝用上面的默认科目）" />
                  <ItemsControl ItemsSource="{Binding SubjectRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SubjectRow">
                        <Grid ColumnDefinitions="*,140" Margin="0,0,0,6">
                          <TextBlock Classes="bodyMedium" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"
                                     Text="{Binding Name}" />
                          <TextBox Grid.Column="1" Classes="outlined dense"
                                   Watermark="留空＝默认"
                                   Text="{Binding Subject}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <Button Classes="tonal block" Content="保存任教科目"
                        Command="{Binding SaveSubjectsCommand}" />

                <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                           IsVisible="{Binding SubjectStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="{DynamicResource Md3.Primary}"
                           Text="{Binding SubjectStatus}" />
              </StackPanel>
            </md3:Md3Card>

            <!-- ==================== 分享链接一键绑定 ==================== -->
            <md3:Md3Card Classes="outlined" CardPadding="14">
              <StackPanel Spacing="10">
                <TextBlock Classes="cardTitle" Text="用分享链接绑定" />

                <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="管理员给你一条链接（例如 https://你的服务器/share/xxxx），粘到下面点「加入我的账号」：这几个班级会加到「管理员分配的班级」里，之后点一下就能绑定，不必再抄 UUID 与口令。" />

                <TextBox Classes="outlined dense"
                         Watermark="粘贴分享链接"
                         Text="{Binding ShareLinkInput}" />

                <Button Classes="tonal block" Content="加入我的账号"
                        Command="{Binding ClaimShareCommand}" />

                <Border IsVisible="{Binding HasShareError}"
                        Background="{DynamicResource Md3.ErrorContainer}"
                        CornerRadius="10" Padding="10,8">
                  <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                             Foreground="{DynamicResource Md3.OnErrorContainer}"
                             Text="{Binding ShareError}" />
                </Border>
              </StackPanel>
            </md3:Md3Card>

            <md3:Md3Card Classes="outlined" CardPadding="14">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                  <TextBlock Classes="cardTitle" Text="运行日志" />

                  <!-- 日志详细程度：默认"信息"。要排查"扫不到教室""这条到底发出去没有"时，
                       调到"调试"才看得到广播发到哪、谁回了什么。 -->
                  <ComboBox Grid.Column="1" MinWidth="110" VerticalAlignment="Center"
                            ToolTip.Tip="{Binding LogLevelHint}"
                            ItemsSource="{Binding LogLevelOptions}"
                            SelectedItem="{Binding SelectedLogLevel}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="remote:AppLogLevelOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>

                  <Button Grid.Column="2" Classes="text small" Content="断开"
                          IsVisible="{Binding IsConnected}"
                          Command="{Binding DisconnectCommand}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Logs}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TeacherLogEntry">
                      <Grid ColumnDefinitions="Auto,*" Margin="0,1">
                        <TextBlock Classes="bodySmall" Width="64"
                                   Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                                   Text="{Binding TimeText}" />
                        <TextBlock Grid.Column="1" Classes="bodySmall" TextWrapping="Wrap"
                                   Text="{Binding Message}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </md3:Md3Card>

            <!--
              个性化：换主题色。与教室端共用同一个控件，
              持久化由本视图的代码后置负责（控件只抛选择结果）。
            -->
            <md3:Md3Card Classes="outlined" CardPadding="14">
              <!-- 名字不叫 Theme：Avalonia 的 StyledElement.Theme 会与 x:Name 撞名 -->
              <md3:ThemePicker x:Name="Appearance" />
            </md3:Md3Card>

            <!--
              检查更新：GitHub 在校园网里常常慢到不能用，所以镜像源可自定义。
              检查只在你按下去的时候发生 —— 不做后台轮询。
            -->
            <md3:Md3Card Classes="outlined" CardPadding="14">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="cardTitle" Text="版本与更新" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="tonal small" Content="检查更新"
                          Command="{Binding Update.CheckCommand}" />
                </Grid>

                <!--
                  这一行版本号与「关于」里那一行都接受"连点 10 次开启开发者模式"：
                  用户会去点自己最先看到的那一行 —— 只有一处能点开，
                  会让人以为开发者模式没了。
                -->
                <TextBlock x:Name="UpdateVersionText" Classes="bodySmall" TextWrapping="Wrap"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="{Binding Update.CurrentVersionText}" />

                <TextBlock x:Name="UpdateVersionHint" Classes="bodySmall" TextWrapping="Wrap"
                           IsVisible="False"
                           Foreground="{DynamicResource Md3.Primary}" />

                <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                           IsVisible="{Binding Update.Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="{DynamicResource Md3.Primary}"
                           Text="{Binding Update.Status}" />

                <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                           IsVisible="{Binding Update.Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="{Binding Update.Notes}" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="tonal small" Content="下载新版"
                          IsVisible="{Binding Update.HasDownload}"
                          Command="{Binding Update.OpenDownloadCommand}" />
                  <Button Classes="outlined small" Content="打开发行版页面"
                          IsVisible="{Binding Update.CanOpenPage}"
                          Command="{Binding Update.OpenPageCommand}" />
                </StackPanel>

                <TextBlock Classes="bodySmall"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="{Binding Update.LastCheckedText}" />

                <!-- ===== 镜像源：内置几条，也可以自己加 ===== -->
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="bodySmall" VerticalAlignment="Center"
                             Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                             Text="镜像源（点「用这个」切换）" />
                  <Button Grid.Column="1" Classes="tonal small" Content="一键检测全部"
                          Command="{Binding Update.TestAllCommand}" />
                </Grid>

                <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                           IsVisible="{Binding Update.TestSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="{DynamicResource Md3.Primary}"
                           Text="{Binding Update.TestSummary}" />

                <ItemsControl ItemsSource="{Binding Update.Mirrors}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="design:MirrorRow">
                      <Border CornerRadius="10" Margin="0,0,0,6" Padding="10"
                              Background="{DynamicResource Md3.SurfaceContainerHigh}">
                        <StackPanel Spacing="3">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="bodyMedium" Text="{Binding Label}" />
                            <Border IsVisible="{Binding IsSelected}"
                                    CornerRadius="9999" Padding="7,1" VerticalAlignment="Center"
                                    Background="{DynamicResource Md3.PrimaryContainer}">
                              <TextBlock Classes="labelSmall"
                                         Foreground="{DynamicResource Md3.OnPrimaryContainer}"
                                         Text="使用中" />
                            </Border>
                          </StackPanel>
                          <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                                     Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                                     Text="{Binding DetailText}" />
                          <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                                     Text="{Binding ResultText}" />
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="tonal small" Content="用这个"
                                    Command="{Binding SelectCommand}" />
                            <Button Classes="text small" Content="删除"
                                    IsVisible="{Binding CanRemove}"
                                    Command="{Binding RemoveCommand}" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 加一条自己的镜像 -->
                <Expander Header="添加镜像源" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="8" Margin="0,8,0,0">
                    <TextBox Classes="outlined dense" Watermark="名字，例如 校园代理"
                             Text="{Binding Update.NewLabel}" />
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="bodySmall" VerticalAlignment="Center"
                                 Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                                 Text="这条镜像在 Gitee 上" />
                      <ToggleSwitch Grid.Column="1" IsChecked="{Binding Update.NewIsGitee}" />
                    </Grid>
                    <TextBox Classes="outlined dense"
                             Watermark="API 地址，留空＝按上面那项用默认"
                             Text="{Binding Update.NewApiBase}" />
                    <TextBox Classes="outlined dense"
                             Watermark="仓库，例如 li-hansen136/ClassShout（留空＝与默认相同）"
                             Text="{Binding Update.NewRepository}" />
                    <TextBox Classes="outlined dense"
                             Watermark="下载地址模板，例如 https://ghproxy.net/{url}"
                             Text="{Binding Update.NewTemplate}" />
                    <Button Classes="tonal small" HorizontalAlignment="Left" Content="添加"
                            Command="{Binding Update.AddMirrorCommand}" />
                    <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                               Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                               Text="模板里 {url} 是整段原始地址、{path} 是去掉 github.com/ 之后的部分；留空表示用该站原地址。" />
                  </StackPanel>
                </Expander>

                <!-- ===== 代理：连不上 GitHub 时最常要改的就是这里 ===== -->
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="bodySmall" VerticalAlignment="Center"
                             Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                             Text="代理" />
                </Grid>

                <ComboBox HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Update.ProxyModes}"
                          SelectedItem="{Binding Update.SelectedProxyMode}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="design:ProxyModeOption">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBox Classes="outlined dense"
                         IsVisible="{Binding Update.IsCustomProxy}"
                         Watermark="代理地址，例如 http://127.0.0.1:7890"
                         Text="{Binding Update.ProxyUrl}" />

                <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                           Foreground="{DynamicResource Md3.Primary}"
                           Text="{Binding Update.ProxyHintText}" />

                <Button Classes="text small" HorizontalAlignment="Left" Content="保存设置"
                        Command="{Binding Update.SaveCommand}" />
              </StackPanel>
            </md3:Md3Card>

            <!--
              「关于」：版本号、运行环境，以及藏在版本号后面的开发者模式。
              在版本号上连点 10 次即可解锁（手势借自 ClassIsland）。
            -->
            <md3:Md3Card Classes="outlined" CardPadding="14">
              <md3:AboutPanel x:Name="About" />
            </md3:Md3Card>

          </StackPanel>
        </ScrollViewer>

      </Panel>

      <!-- ==================== 底部导航 ==================== -->
      <Border Grid.Row="3" Background="{DynamicResource Md3.SurfaceContainer}" Padding="10,4">
        <Grid ColumnDefinitions="*,*,*,*,*">
          <RadioButton Grid.Column="0" Theme="{StaticResource Md3NavItem}"
                       GroupName="Md3Nav" Tag="文字"
                       IsChecked="{Binding IsTextPage, Mode=OneWay}"
                       Command="{Binding NavigateTextCommand}">
            <md3:Md3Icon Kind="MessageText" Size="24" />
          </RadioButton>
          <RadioButton Grid.Column="1" Theme="{StaticResource Md3NavItem}"
                       GroupName="Md3Nav" Tag="语音"
                       IsChecked="{Binding IsVoicePage, Mode=OneWay}"
                       Command="{Binding NavigateVoiceCommand}">
            <md3:Md3Icon Kind="Microphone" Size="24" />
          </RadioButton>
          <RadioButton Grid.Column="2" Theme="{StaticResource Md3NavItem}"
                       GroupName="Md3Nav" Tag="名单"
                       IsChecked="{Binding IsStudentsPage, Mode=OneWay}"
                       Command="{Binding NavigateStudentsCommand}">
            <md3:Md3Icon Kind="AccountMultiple" Size="24" />
          </RadioButton>
          <RadioButton Grid.Column="3" Theme="{StaticResource Md3NavItem}"
                       GroupName="Md3Nav" Tag="呼叫"
                       IsChecked="{Binding IsCallPage, Mode=OneWay}"
                       Command="{Binding NavigateCallCommand}">
            <md3:Md3Icon Kind="Bullhorn" Size="24" />
          </RadioButton>
          <RadioButton Grid.Column="4" Theme="{StaticResource Md3NavItem}"
                       GroupName="Md3Nav" Tag="设备"
                       IsChecked="{Binding IsDevicesPage, Mode=OneWay}"
                       Command="{Binding NavigateDevicesCommand}">
            <md3:Md3Icon Kind="CastConnected" Size="24" />
          </RadioButton>
        </Grid>
      </Border>
    </Grid>

    <!-- ==================== 浮动提示 ==================== -->
    <Border IsVisible="{Binding IsSnackbarVisible}"
            VerticalAlignment="Bottom" HorizontalAlignment="Center"
            Margin="20,0,20,96"
            Background="{DynamicResource Md3.InverseSurface}"
            CornerRadius="8" Padding="16,10"
            BoxShadow="{DynamicResource Md3.Elevation.Level3}">
      <TextBlock Classes="bodyMedium"
                 Foreground="{DynamicResource Md3.InverseOnSurface}"
                 Text="{Binding SnackbarMessage}" />
    </Border>
  </Panel>
</UserControl>
