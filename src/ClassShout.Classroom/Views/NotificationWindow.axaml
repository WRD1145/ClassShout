<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md3="using:ClassShout.Design.Controls"
        xmlns:svc="using:ClassShout.Classroom.Services"
        xmlns:remote="using:ClassShout.Core.Remote"
        x:Class="ClassShout.Classroom.Views.NotificationWindow"
        x:DataType="svc:NotificationContent"
        SystemDecorations="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False"
        SizeToContent="Height"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        WindowStartupLocation="Manual">

  <!-- 淡入淡出：通知突然出现会很突兀，短促的渐变能显著降低"被吓一跳"的感觉 -->
  <Window.Transitions>
    <Transitions>
      <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
    </Transitions>
  </Window.Transitions>

  <!--
    外层留出 Margin 是为了让阴影有地方画：窗口背景透明，
    阴影画在 Border 上就能溢出到窗口边缘之外。
  -->
  <Border Margin="14"
          Background="{DynamicResource Md3.SurfaceContainerHigh}"
          BorderBrush="{DynamicResource Md3.OutlineVariant}"
          BorderThickness="1"
          CornerRadius="{DynamicResource Md3.Shape.Large}"
          BoxShadow="{DynamicResource Md3.Elevation.Level3}"
          Padding="16,14">
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">

      <Border Width="44" Height="44" CornerRadius="22"
              VerticalAlignment="Top"
              Background="{DynamicResource Md3.PrimaryContainer}">
        <Panel>
          <md3:Md3Icon Kind="Bullhorn" Size="24"
                       IconBrush="{DynamicResource Md3.OnPrimaryContainer}"
                       IsVisible="{Binding !IsVoice}" />
          <md3:Md3Icon Kind="Microphone" Size="24"
                       IconBrush="{DynamicResource Md3.OnPrimaryContainer}"
                       IsVisible="{Binding IsVoice}" />
        </Panel>
      </Border>

      <StackPanel Grid.Column="1" Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="titleSmall" TextTrimming="CharacterEllipsis"
                     Text="{Binding SourceName}" />
          <TextBlock Grid.Column="1" Classes="labelSmall"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                     Text="{Binding TimeText}" />
        </Grid>

        <!-- 图片喊话：图在上、说明在下。弹窗只占屏幕一角，所以图也要限高，
             否则一张竖图会把卡片撑到屏幕外面去。 -->
        <Image IsVisible="{Binding HasImage}"
               Source="{Binding Image}"
               Stretch="Uniform" MaxHeight="220"
               HorizontalAlignment="Left" />

        <TextBlock Classes="bodyLarge" TextWrapping="Wrap"
                   MaxLines="8" TextTrimming="CharacterEllipsis"
                   FontSize="{Binding TextFontSize}"
                   Text="{Binding Text}" />

        <TextBlock Classes="bodySmall"
                   Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                   Text="{Binding Hint}" />

        <!-- 弹窗上的回复区。
             发送方选了「只弹窗」时，教室里那块屏上只有这张卡片 —— 主窗口的回复栏
             等于被藏起来了，所以卡片自己也带一套：知道了 + 快捷回复 + 语音回复。
             命令与状态都绑 ReplyHost（教室端视图模型），两处显示的是同一份状态。 -->
        <StackPanel Spacing="6" IsVisible="{Binding CanAcknowledge}">
          <Button Classes="tonal small" HorizontalAlignment="Left"
                  IsVisible="{Binding CanAcknowledge}"
                  Command="{Binding AcknowledgeCommand}"
                  Content="知道了" />

          <ItemsControl ItemsSource="{Binding ReplyHost.ReplyQuickReplies}"
                        IsVisible="{Binding HasReplyControls}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="remote:QuickReply">
                <Button Classes="outlined small" Margin="0,0,6,4" Content="{Binding Label}"
                        Command="{Binding $parent[ItemsControl].((svc:NotificationContent)DataContext).ReplyHost.SendQuickReplyCommand}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Orientation="Horizontal" Spacing="8"
                      IsVisible="{Binding HasReplyControls}">
            <Button Classes="outlined small"
                    Command="{Binding ReplyHost.ToggleVoiceReplyCommand}"
                    Content="{Binding ReplyHost.ReplyVoiceButtonText}"
                    IsVisible="{Binding ReplyHost.ShowVoiceReply}" />
            <TextBlock Classes="bodySmall" VerticalAlignment="Center"
                       IsVisible="{Binding ReplyHost.IsRecordingReply}"
                       Text="{Binding ReplyHost.ReplyRecordText}" />
            <Button Classes="text small" Content="放弃"
                    IsVisible="{Binding ReplyHost.IsRecordingReply}"
                    Command="{Binding ReplyHost.CancelVoiceReplyCommand}" />
            <TextBlock Classes="bodySmall" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxWidth="220"
                       Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                       Text="{Binding ReplyHost.LastReplyText}" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</Window>
