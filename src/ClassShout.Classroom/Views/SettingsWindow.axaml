<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md3="using:ClassShout.Design.Controls"
        xmlns:vm="using:ClassShout.Classroom.ViewModels"
        xmlns:svc="using:ClassShout.Classroom.Services"
        xmlns:core="using:ClassShout.Core.Audio"
        x:Class="ClassShout.Classroom.Views.SettingsWindow"
        x:DataType="vm:ClassroomViewModel"
        Title="ClassShout 教室端 · 设置"
        Width="520" Height="820"
        MinWidth="440" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Md3.Surface}">

  <Window.Styles>
    <Style Selector="TextBlock.cardTitle">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="{DynamicResource Md3.Weight.Emphasis}" />
      <Setter Property="Foreground" Value="{DynamicResource Md3.OnSurfaceVariant}" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ==================== 顶栏 ==================== -->
    <Border Grid.Row="0" Background="{DynamicResource Md3.SurfaceContainer}" Padding="20,14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Width="40" Height="40" CornerRadius="12"
                Background="{DynamicResource Md3.PrimaryContainer}">
          <md3:Md3Icon Kind="Cog" Size="22" Classes="onPrimaryContainer" />
        </Border>

        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock Classes="titleMedium" Text="设置" />
          <TextBlock Classes="bodySmall" Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                     Text="{Binding SettingsLockHint}" />
        </StackPanel>

        <Button Grid.Column="2" Classes="tonal small" Content="关闭" Click="OnCloseClick" />
      </Grid>
    </Border>

    <!-- ==================== 设置项 ==================== -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,18">
      <StackPanel Spacing="16">

        <md3:Md3Card Classes="outlined">
          <StackPanel Spacing="12">
            <TextBlock Classes="cardTitle" Text="设置口令" />

            <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                       Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                       Text="可选。开启后进入本设置界面需要先输入一个本机 PIN，防止路过教室电脑的人顺手改配置。它只拦随手乱改，不等于账号口令 —— 配置就在本机，能读到文件的人删掉它即可绕过。" />

            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Classes="bodyMedium" Text="进入设置需要输入 PIN" />
                <TextBlock Classes="bodySmall" Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="进入时验一次，关掉本窗口后重新上锁" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                            IsChecked="{Binding SettingsLockEnabled}" />
            </Grid>

            <StackPanel Spacing="6" IsVisible="{Binding SettingsLockEnabled}">
              <TextBlock Classes="bodyMedium" Text="设置 PIN（4~32 位数字）" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Classes="outlined dense" PasswordChar="●"
                         Watermark="输入新的 PIN"
                         Text="{Binding NewPin}" />
                <Button Grid.Column="1" Classes="tonal" Content="保存 PIN"
                        Command="{Binding SavePinCommand}" />
              </Grid>
              <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                         Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                         Text="{Binding SettingsLockError}" />
            </StackPanel>
          </StackPanel>
        </md3:Md3Card>
        <md3:Md3Card Classes="outlined">
          <StackPanel Spacing="10">
            <TextBlock Classes="cardTitle" Text="教室信息" />

            <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                       Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                       Text="这个名字会出现在教师端的扫描列表、喊话弹窗和服务器控制台上，例如「三年二班」。改完会自动同步到服务器。" />

            <TextBox Classes="outlined dense"
                     Watermark="教室名"
                     Text="{Binding ClassroomName}" />

            <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                       Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                       Text="{Binding LocalAddressDisplay, StringFormat='本机地址：{0}'}" />
          </StackPanel>
        </md3:Md3Card>

        <md3:Md3Card Classes="outlined">
          <StackPanel Spacing="18">
            <TextBlock Classes="cardTitle" Text="朗读设置" />

            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="bodyMedium" Text="音量" />
                <TextBlock Grid.Column="1" Classes="bodyMedium"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="{Binding VolumeText}" />
              </Grid>
              <Slider Minimum="0" Maximum="100" Value="{Binding Volume}" />
            </StackPanel>

            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="bodyMedium" Text="语速" />
                <TextBlock Grid.Column="1" Classes="bodyMedium"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="{Binding RateText}" />
              </Grid>
              <Slider Minimum="-6" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True"
                      Value="{Binding Rate}" />
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Classes="bodyMedium" Text="朗读引擎" />
              <ComboBox HorizontalAlignment="Stretch"
                        ItemsSource="{Binding EngineOptions}"
                        SelectedItem="{Binding SelectedEngine}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:SpeechEngineOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                         Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                         Text="在线语音更自然，但需要教室电脑能上外网；连不上时会自动回落到系统语音，不会不发声。" />
            </StackPanel>

            <!-- 系统语音：不在线引擎时才显示，免得两个音色列表同时摆着让人分不清哪个生效 -->
            <StackPanel Spacing="6" IsVisible="{Binding !IsEdgeEngine}">
              <TextBlock Classes="bodyMedium" Text="系统语音" />
              <ComboBox HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Voices}"
                        SelectedItem="{Binding SelectedVoice}" />
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding IsEdgeEngine}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="bodyMedium" Text="在线音色" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="text small" Content="刷新列表"
                        Command="{Binding RefreshEdgeVoicesCommand}" />
              </Grid>
              <ComboBox HorizontalAlignment="Stretch"
                        ItemsSource="{Binding EdgeVoices}"
                        SelectedItem="{Binding SelectedEdgeVoice}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="core:EdgeVoiceInfo">
                    <TextBlock Text="{Binding Display}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                         IsVisible="{Binding !EdgeVoices.Count}"
                         Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                         Text="还没拿到音色列表。点「刷新列表」试试；拉不到就说明这台机器连不上外网。" />
            </StackPanel>

            <Border Background="{DynamicResource Md3.SurfaceContainerHighest}"
                    CornerRadius="8" Padding="10,8">
              <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                         Text="{Binding SpeechEngineStatus, StringFormat='当前实际在用：{0}'}" />
            </Border>

            <Button Classes="tonal block" Command="{Binding TestSpeechCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <md3:Md3Icon Kind="Play" Size="18" Classes="secondary" />
                <TextBlock Text="试听当前语音" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </md3:Md3Card>

        <!-- ==================== 跨局域网（中继服务器） ==================== -->
        <md3:Md3Card Classes="outlined">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="cardTitle" Text="跨局域网喊话" Margin="0" />
              <Border Grid.Column="1" CornerRadius="9999" Padding="9,3"
                      Background="{DynamicResource Md3.SecondaryContainer}">
                <TextBlock Classes="labelSmall"
                           Foreground="{DynamicResource Md3.OnSecondaryContainer}"
                           Text="{Binding RelayStatusText}" />
              </Border>
            </Grid>

            <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                       Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                       Text="教师端与教室不在同一网络时，把两端都接到同一台中继服务器即可，形如 https://relay.example.com 或 http://192.168.1.10:8080。不填也能用，局域网直连照常工作。" />

            <TextBox Classes="outlined dense"
                     Watermark="服务器地址"
                     Text="{Binding RelayServerUrl}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <Button Grid.Column="0" Classes="tonal block" Content="连接服务器"
                      Command="{Binding ConnectRelayCommand}" />
              <Button Grid.Column="1" Classes="outlined block" Content="断开"
                      Command="{Binding DisconnectRelayCommand}" />
            </Grid>

            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRelayBusy}" />

            <Border IsVisible="{Binding HasRelayError}"
                    Background="{DynamicResource Md3.ErrorContainer}"
                    CornerRadius="10" Padding="10,8">
              <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                         Foreground="{DynamicResource Md3.OnErrorContainer}"
                         Text="{Binding RelayError}" />
            </Border>

            <!-- 这两项要抄给老师，所以要能一眼看清并能一键复制 -->
            <StackPanel Spacing="8">
              <TextBlock Classes="cardTitle" Text="本教室身份（请抄给任课老师）" />

              <StackPanel Spacing="4">
                <TextBlock Classes="bodySmall"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="教室 UUID" />
                <Grid ColumnDefinitions="*,Auto">
                  <Border Background="{DynamicResource Md3.SurfaceContainerHighest}"
                          CornerRadius="6" Padding="8,6">
                    <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                               FontFamily="Consolas, monospace"
                               Text="{Binding RelayUuid}" />
                  </Border>
                  <Button Grid.Column="1" Classes="icon" Margin="6,0,0,0"
                          Command="{Binding CopyRelayUuidCommand}" ToolTip.Tip="复制 UUID">
                    <md3:Md3Icon Kind="ContentCopy" Size="18" />
                  </Button>
                </Grid>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Classes="bodySmall"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="口令（Secret）" />
                <Grid ColumnDefinitions="*,Auto">
                  <Border Background="{DynamicResource Md3.SurfaceContainerHighest}"
                          CornerRadius="6" Padding="8,6">
                    <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                               FontFamily="Consolas, monospace"
                               Text="{Binding SecretDisplay}" />
                  </Border>
                  <Button Grid.Column="1" Classes="icon" Margin="6,0,0,0"
                          IsEnabled="{Binding HasRelaySecret}"
                          Command="{Binding CopyRelaySecretCommand}" ToolTip.Tip="复制口令">
                    <md3:Md3Icon Kind="ContentCopy" Size="18" />
                  </Button>
                </Grid>
              </StackPanel>

              <Button Classes="text small" HorizontalAlignment="Left"
                      Content="重新生成 UUID（会使已绑定的教师端全部失效）"
                      Command="{Binding RegenerateUuidCommand}" />
            </StackPanel>
          </StackPanel>
        </md3:Md3Card>

        <!-- ==================== 屏幕边缘弹窗 ==================== -->
        <md3:Md3Card Classes="outlined">
          <StackPanel Spacing="14">
            <TextBlock Classes="cardTitle" Text="喊话弹窗" />

            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Classes="bodyMedium" Text="收到喊话时在屏幕边缘弹出提示" />
                <TextBlock Classes="bodySmall"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="不抢焦点，也不进入 Alt+Tab" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                            IsChecked="{Binding NotificationEnabled}" />
            </Grid>

            <StackPanel Spacing="6" IsEnabled="{Binding NotificationEnabled}">
              <TextBlock Classes="bodyMedium" Text="出现位置" />
              <ComboBox HorizontalAlignment="Stretch"
                        ItemsSource="{Binding CornerOptions}"
                        SelectedItem="{Binding SelectedCorner}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="svc:CornerOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <StackPanel Spacing="6" IsEnabled="{Binding NotificationEnabled}">
              <TextBlock Classes="bodyMedium" Text="提示方式" />
              <ComboBox HorizontalAlignment="Stretch"
                        ItemsSource="{Binding ChannelOptions}"
                        SelectedItem="{Binding SelectedChannel}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="svc:ShoutChannelOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                         Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                         Text="{Binding ChannelHint}" />
            </StackPanel>

            <StackPanel Spacing="6" IsEnabled="{Binding NotificationEnabled}">
              <TextBlock Classes="bodyMedium" Text="置顶档位" />
              <ComboBox x:Name="TopmostPicker"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding TopmostOptions}"
                        SelectedItem="{Binding SelectedTopmost}">
                <!--
                  让"存在但不可用"的档位真的选不动。
                  IsEnabled 必须在**容器**上生效，光把文字调暗只是看起来灰、照样能选中；
                  这里给 ComboBoxItem 挂一个基于默认主题的 ControlTheme，只加一条 Setter，
                  外观（Fluent/MD3 的选中态、悬停态）仍由原主题提供。

                  用 ReflectionBinding 而不是 Binding：ControlTheme 里的编译期绑定会
                  按窗口的 x:DataType（ClassroomViewModel）去解析，找不到 IsAvailable 而编译失败。
                  反射绑定按运行时实际的 DataContext（也就是列表项本身）解析，正合此处。
                -->
                <ComboBox.ItemContainerTheme>
                  <ControlTheme TargetType="ComboBoxItem"
                                BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                    <Setter Property="IsEnabled" Value="{ReflectionBinding IsAvailable}" />
                  </ControlTheme>
                </ComboBox.ItemContainerTheme>
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="svc:TopmostOption">
                    <TextBlock Text="{Binding Label}"
                               Opacity="{Binding Opacity}"
                               ToolTip.Tip="{Binding UnavailableReason}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                         Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                         Text="{Binding TopmostModeHint}" />
              <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                         Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                         Text="「UIA 置顶」需要程序数字签名并安装在安全目录（Windows 对 UIAccess 的硬性要求），当前为未签名的便携版本，因此该档暂不可用。" />
            </StackPanel>

            <StackPanel Spacing="6" IsEnabled="{Binding NotificationEnabled}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="bodyMedium" Text="停留时长" />
                <TextBlock Grid.Column="1" Classes="bodySmall"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="{Binding NotificationDurationText}" />
              </Grid>
              <Slider Minimum="0" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                      Value="{Binding NotificationDuration}" />
            </StackPanel>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <Button Grid.Column="0" Classes="tonal block" Content="预览弹窗"
                      IsEnabled="{Binding NotificationEnabled}"
                      Command="{Binding PreviewNotificationCommand}" />
              <Button Grid.Column="1" Classes="outlined block" Content="立即关闭"
                      Command="{Binding HideNotificationCommand}" />
            </Grid>
          </StackPanel>
        </md3:Md3Card>

        <md3:Md3Card Classes="outlined">
          <StackPanel Spacing="8">
            <TextBlock Classes="cardTitle" Text="后台运行" />
            <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                       Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                       Text="点关闭按钮不会退出，而是缩到通知区域继续接收喊话 —— 教室里顺手点一下 × 不该让全班失联。双击托盘图标可以重新打开，要完全退出请右键托盘图标选「退出」。" />
            <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                       Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                       Text="电脑关机、注销或重启时会正常退出，不会被窗口拦住。" />

            <!-- 开机自启。Linux 上显示不出来：那边的部署走 systemd 单元，没有"启动文件夹"这一套 -->
            <StackPanel Spacing="4" Margin="0,6,0,0" IsVisible="{Binding SupportsAutoStart}">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Classes="bodyMedium" Text="开机自启" />
                  <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                             Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                             Text="在「启动」文件夹里放一个快捷方式，登录 Windows 后自动打开教室端。" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                              IsChecked="{Binding AutoStart}" />
              </Grid>
              <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                         Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                         Text="{Binding AutoStartLocation, StringFormat='启动文件夹：{0}'}" />
            </StackPanel>
          </StackPanel>
        </md3:Md3Card>

        <md3:Md3Card Classes="outlined">
          <StackPanel Spacing="10">
            <TextBlock Classes="cardTitle" Text="在线教师端" />
            <TextBlock Classes="bodyMedium" IsVisible="{Binding !HasTeachers}"
                       Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                       Text="暂无教师端连接" />
            <ItemsControl ItemsSource="{Binding Teachers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TeacherInfo">
                  <Border CornerRadius="10" Padding="10" Margin="0,0,0,6"
                          Background="{DynamicResource Md3.SurfaceContainerHigh}">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="bodyMedium" Text="{Binding Name}" />
                      <TextBlock Classes="bodySmall"
                                 Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                                 Text="{Binding RemoteEndPoint}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </md3:Md3Card>
        <md3:Md3Card Classes="outlined">
          <!--
            个性化：换主题色。
            做成共享控件（ClassShout.Design.Controls.ThemePicker）而不是在这里铺一遍 XAML ——
            教师端也有同一项，各写一份迟早会长歪。
            持久化由本窗口的代码后置负责，控件只抛选择结果。
          -->
          <!--
            名字刻意不叫 Theme：Avalonia 的 StyledElement 上已经有一个 Theme 属性
            （给 ControlTheme 用的），x:Name 取同名会撞出 CS0108 警告。
          -->
          <md3:ThemePicker x:Name="Appearance" />
        </md3:Md3Card>

        <!--
          「关于」：版本号、运行环境，以及藏在版本号后面的开发者模式。
          在版本号上连点 10 次即可解锁（手势借自 ClassIsland，两边用同一套约定）。
        -->
        <md3:Md3Card Classes="outlined">
          <md3:AboutPanel x:Name="About" />
        </md3:Md3Card>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{DynamicResource Md3.SurfaceContainerLow}" Padding="20,12">
      <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                 Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                 Text="改动即时生效并自动保存。关掉本窗口不影响喊话接收。" />
    </Border>

  </Grid>
</Window>