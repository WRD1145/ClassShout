<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md3="using:ClassShout.Design.Controls"
        xmlns:vm="using:ClassShout.Classroom.ViewModels"
        xmlns:svc="using:ClassShout.Classroom.Services"
        x:Class="ClassShout.Classroom.Views.MainWindow"
        x:DataType="vm:ClassroomViewModel"
        Title="ClassShout 教室端"
        Width="1320" Height="860"
        MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Md3.Surface}">

  <Window.Styles>
    <!-- 状态胶囊：MD3 里用容器的圆角 + 小号 Label -->
    <Style Selector="Border.chip">
      <Setter Property="CornerRadius" Value="{DynamicResource Md3.Shape.Full}" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Background" Value="{DynamicResource Md3.SecondaryContainer}" />
    </Style>
    <Style Selector="Border.chip TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Md3.OnSecondaryContainer}" />
    </Style>
    <Style Selector="Border.chip.alert">
      <Setter Property="Background" Value="{DynamicResource Md3.ErrorContainer}" />
    </Style>
    <Style Selector="Border.chip.alert TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Md3.OnErrorContainer}" />
    </Style>
    <Style Selector="TextBlock.cardTitle">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="{DynamicResource Md3.Weight.Emphasis}" />
      <Setter Property="Foreground" Value="{DynamicResource Md3.OnSurfaceVariant}" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ==================== 顶栏 ==================== -->
    <Border Grid.Row="0" Background="{DynamicResource Md3.SurfaceContainer}" Padding="24,14">
      <Grid ColumnDefinitions="Auto,*,Auto">

        <StackPanel Orientation="Horizontal" Spacing="14">
          <Border Width="46" Height="46" CornerRadius="14" Background="{DynamicResource Md3.Primary}">
            <md3:Md3Icon Kind="School" Size="26" Classes="onPrimary" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Classes="titleLarge" Text="{Binding ClassroomName}" />
            <TextBlock Classes="bodySmall" Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                       Text="{Binding LocalAddressDisplay}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">

          <Border Classes="chip">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <md3:Md3Icon Kind="Wifi" Size="16" Classes="secondary" />
              <TextBlock Classes="labelLarge" Text="{Binding TeacherCountText}" />
            </StackPanel>
          </Border>

          <Border Classes="chip alert" IsVisible="{Binding IsMuted}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <md3:Md3Icon Kind="VolumeOff" Size="16" Classes="error" />
              <TextBlock Classes="labelLarge" Text="已静音" />
            </StackPanel>
          </Border>

          <!-- 静音开关：两个图标按状态互斥显示，比写转换器更直观 -->
          <Button Classes="icon" Command="{Binding ToggleMuteCommand}" ToolTip.Tip="静音 / 取消静音">
            <Panel>
              <md3:Md3Icon Kind="VolumeHigh" Size="22" Classes="onSurface" IsVisible="{Binding !IsMuted}" />
              <md3:Md3Icon Kind="VolumeOff" Size="22" Classes="error" IsVisible="{Binding IsMuted}" />
            </Panel>
          </Button>

          <Button Classes="icon" Command="{Binding StopEverythingCommand}" ToolTip.Tip="立即停止朗读与播放">
            <md3:Md3Icon Kind="Stop" Size="22" Classes="onSurface" />
          </Button>

          <Button Classes="icon" Click="OnToggleTheme" ToolTip.Tip="切换亮色 / 暗色">
            <md3:Md3Icon Kind="ThemeLightDark" Size="22" Classes="onSurface" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ==================== 主区 ==================== -->
    <Grid Grid.Row="1" ColumnDefinitions="*,380" Margin="24,20" ColumnSpacing="20">

      <!-- 舞台：学生看到的大字区 -->
      <md3:Md3Card Grid.Column="0" Classes="filled" CardPadding="0" ClipToBounds="True">
        <Panel>

          <!-- 待机 -->
          <StackPanel IsVisible="{Binding IsIdle}"
                      VerticalAlignment="Center" HorizontalAlignment="Center"
                      Spacing="18" Margin="48">
            <Border Width="112" Height="112" CornerRadius="56"
                    Background="{DynamicResource Md3.PrimaryContainer}"
                    HorizontalAlignment="Center">
              <md3:Md3Icon Kind="CastConnected" Size="56"
                           IconBrush="{DynamicResource Md3.OnPrimaryContainer}" />
            </Border>
            <TextBlock Classes="headlineMedium" HorizontalAlignment="Center"
                       Text="{Binding StageHeadline}" />
            <TextBlock Classes="bodyLarge" HorizontalAlignment="Center" TextAlignment="Center"
                       MaxWidth="520" TextWrapping="Wrap"
                       Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                       Text="{Binding IdleHint}" />
          </StackPanel>

          <!-- 文字朗读中 -->
          <StackPanel IsVisible="{Binding IsSpeakingText}"
                      VerticalAlignment="Center" HorizontalAlignment="Center"
                      Spacing="20" Margin="56">
            <Border Classes="chip" HorizontalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <md3:Md3Icon Kind="Bullhorn" Size="16" Classes="secondary" />
                <TextBlock Classes="labelLarge" Text="正在朗读" />
              </StackPanel>
            </Border>
            <TextBlock Classes="labelLarge" HorizontalAlignment="Center"
                       Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                       Text="{Binding SpeakerText, StringFormat='来自 {0}'}" />
            <TextBlock Classes="displaySmall" TextAlignment="Center" TextWrapping="Wrap"
                       MaxWidth="760" MaxHeight="360"
                       Text="{Binding CurrentText}" />
          </StackPanel>

          <!-- 语音播放中 -->
          <StackPanel IsVisible="{Binding IsPlayingAudio}"
                      VerticalAlignment="Center" HorizontalAlignment="Stretch"
                      Spacing="22" Margin="56">
            <Border Classes="chip" HorizontalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <md3:Md3Icon Kind="Microphone" Size="16" Classes="secondary" />
                <TextBlock Classes="labelLarge" Text="语音喊话中" />
              </StackPanel>
            </Border>
            <TextBlock Classes="headlineSmall" HorizontalAlignment="Center"
                       Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                       Text="{Binding SpeakerText, StringFormat='来自 {0}'}" />
            <Border Background="{DynamicResource Md3.SurfaceContainerHigh}"
                    CornerRadius="20" Height="140" Padding="20">
              <md3:Md3AudioWave Height="100"
                                BarBrush="{DynamicResource Md3.Primary}"
                                Level="{Binding AudioLevel}" />
            </Border>
            <TextBlock Classes="titleMedium" HorizontalAlignment="Center"
                       Text="{Binding AudioSecondsText}" />
          </StackPanel>

        </Panel>
      </md3:Md3Card>

      <!-- 右侧：设置 + 联网 + 在线教师。内容会超出窗口高度，所以整列可滚动 -->
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="16">

        <md3:Md3Card Classes="outlined">
          <StackPanel Spacing="10">
            <TextBlock Classes="cardTitle" Text="教室信息" />

            <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                       Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                       Text="这个名字会出现在教师端的扫描列表、喊话弹窗和服务器控制台上。改完会自动同步到服务器。" />

            <TextBox Classes="outlined dense"
                     Watermark="例如：三年二班"
                     Text="{Binding ClassroomName}" />

            <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                       Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                       Text="{Binding LocalAddressDisplay, StringFormat='本机地址：{0}'}" />
          </StackPanel>
        </md3:Md3Card>

        <md3:Md3Card Classes="outlined">
          <StackPanel Spacing="18">
            <TextBlock Classes="cardTitle" Text="朗读设置" />

            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="bodyMedium" Text="音量" />
                <TextBlock Grid.Column="1" Classes="bodyMedium"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="{Binding VolumeText}" />
              </Grid>
              <Slider Minimum="0" Maximum="100" Value="{Binding Volume}" />
            </StackPanel>

            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="bodyMedium" Text="语速" />
                <TextBlock Grid.Column="1" Classes="bodyMedium"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="{Binding RateText}" />
              </Grid>
              <Slider Minimum="-6" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True"
                      Value="{Binding Rate}" />
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Classes="bodyMedium" Text="系统语音" />
              <ComboBox HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Voices}"
                        SelectedItem="{Binding SelectedVoice}" />
            </StackPanel>

            <Button Classes="tonal block" Command="{Binding TestSpeechCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <md3:Md3Icon Kind="Play" Size="18" Classes="secondary" />
                <TextBlock Text="试听当前语音" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </md3:Md3Card>

        <!-- ==================== 跨局域网（中继服务器） ==================== -->
        <md3:Md3Card Classes="outlined">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="cardTitle" Text="跨局域网喊话" Margin="0" />
              <Border Grid.Column="1" CornerRadius="9999" Padding="9,3"
                      Background="{DynamicResource Md3.SecondaryContainer}">
                <TextBlock Classes="labelSmall"
                           Foreground="{DynamicResource Md3.OnSecondaryContainer}"
                           Text="{Binding RelayStatusText}" />
              </Border>
            </Grid>

            <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                       Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                       Text="教师端与教室不在同一网络时，把两端都接到同一台中继服务器即可。不填也能用，局域网直连照常工作。" />

            <TextBox Classes="outlined dense"
                     Watermark="https://relay.example.com 或 http://192.168.1.10:8080"
                     Text="{Binding RelayServerUrl}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <Button Grid.Column="0" Classes="tonal block" Content="连接服务器"
                      Command="{Binding ConnectRelayCommand}" />
              <Button Grid.Column="1" Classes="outlined block" Content="断开"
                      Command="{Binding DisconnectRelayCommand}" />
            </Grid>

            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRelayBusy}" />

            <Border IsVisible="{Binding HasRelayError}"
                    Background="{DynamicResource Md3.ErrorContainer}"
                    CornerRadius="10" Padding="10,8">
              <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                         Foreground="{DynamicResource Md3.OnErrorContainer}"
                         Text="{Binding RelayError}" />
            </Border>

            <!-- 这两项要抄给老师，所以要能一眼看清并能一键复制 -->
            <StackPanel Spacing="8">
              <TextBlock Classes="cardTitle" Text="本教室身份（请抄给任课老师）" />

              <StackPanel Spacing="4">
                <TextBlock Classes="bodySmall"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="教室 UUID" />
                <Grid ColumnDefinitions="*,Auto">
                  <Border Background="{DynamicResource Md3.SurfaceContainerHighest}"
                          CornerRadius="6" Padding="8,6">
                    <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                               FontFamily="Consolas, monospace"
                               Text="{Binding RelayUuid}" />
                  </Border>
                  <Button Grid.Column="1" Classes="icon" Margin="6,0,0,0"
                          Command="{Binding CopyRelayUuidCommand}" ToolTip.Tip="复制 UUID">
                    <md3:Md3Icon Kind="ContentCopy" Size="18" />
                  </Button>
                </Grid>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Classes="bodySmall"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="口令（Secret）" />
                <Grid ColumnDefinitions="*,Auto">
                  <Border Background="{DynamicResource Md3.SurfaceContainerHighest}"
                          CornerRadius="6" Padding="8,6">
                    <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                               FontFamily="Consolas, monospace"
                               Text="{Binding SecretDisplay}" />
                  </Border>
                  <Button Grid.Column="1" Classes="icon" Margin="6,0,0,0"
                          IsEnabled="{Binding HasRelaySecret}"
                          Command="{Binding CopyRelaySecretCommand}" ToolTip.Tip="复制口令">
                    <md3:Md3Icon Kind="ContentCopy" Size="18" />
                  </Button>
                </Grid>
              </StackPanel>

              <Button Classes="text small" HorizontalAlignment="Left"
                      Content="重新生成 UUID（会使已绑定的教师端全部失效）"
                      Command="{Binding RegenerateUuidCommand}" />
            </StackPanel>
          </StackPanel>
        </md3:Md3Card>

        <!-- ==================== 屏幕边缘弹窗 ==================== -->
        <md3:Md3Card Classes="outlined">
          <StackPanel Spacing="14">
            <TextBlock Classes="cardTitle" Text="喊话弹窗" />

            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Classes="bodyMedium" Text="收到喊话时在屏幕边缘弹出提示" />
                <TextBlock Classes="bodySmall"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="不抢焦点，也不进入 Alt+Tab" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                            IsChecked="{Binding NotificationEnabled}" />
            </Grid>

            <StackPanel Spacing="6" IsEnabled="{Binding NotificationEnabled}">
              <TextBlock Classes="bodyMedium" Text="出现位置" />
              <ComboBox HorizontalAlignment="Stretch"
                        ItemsSource="{Binding CornerOptions}"
                        SelectedItem="{Binding SelectedCorner}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="svc:CornerOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <StackPanel Spacing="6" IsEnabled="{Binding NotificationEnabled}">
              <TextBlock Classes="bodyMedium" Text="置顶档位" />
              <ComboBox HorizontalAlignment="Stretch"
                        ItemsSource="{Binding TopmostOptions}"
                        SelectedItem="{Binding SelectedTopmost}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="svc:TopmostOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                         Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                         Text="{Binding TopmostModeHint}" />
            </StackPanel>

            <StackPanel Spacing="6" IsEnabled="{Binding NotificationEnabled}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="bodyMedium" Text="停留时长" />
                <TextBlock Grid.Column="1" Classes="bodySmall"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                           Text="{Binding NotificationDurationText}" />
              </Grid>
              <Slider Minimum="0" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                      Value="{Binding NotificationDuration}" />
            </StackPanel>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <Button Grid.Column="0" Classes="tonal block" Content="预览弹窗"
                      IsEnabled="{Binding NotificationEnabled}"
                      Command="{Binding PreviewNotificationCommand}" />
              <Button Grid.Column="1" Classes="outlined block" Content="立即关闭"
                      Command="{Binding HideNotificationCommand}" />
            </Grid>
          </StackPanel>
        </md3:Md3Card>

        <md3:Md3Card Classes="outlined">
          <StackPanel Spacing="8">
            <TextBlock Classes="cardTitle" Text="后台运行" />
            <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                       Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                       Text="点关闭按钮不会退出，而是缩到通知区域继续接收喊话 —— 教室里顺手点一下 × 不该让全班失联。双击托盘图标可以重新打开，要完全退出请右键托盘图标选「退出」。" />
            <TextBlock Classes="bodySmall" TextWrapping="Wrap"
                       Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                       Text="电脑关机、注销或重启时会正常退出，不会被窗口拦住。" />
          </StackPanel>
        </md3:Md3Card>

        <md3:Md3Card Classes="outlined">
          <StackPanel Spacing="10">
            <TextBlock Classes="cardTitle" Text="在线教师端" />
            <TextBlock Classes="bodyMedium" IsVisible="{Binding !HasTeachers}"
                       Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                       Text="暂无教师端连接" />
            <ItemsControl ItemsSource="{Binding Teachers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TeacherInfo">
                  <Border CornerRadius="10" Padding="10" Margin="0,0,0,6"
                          Background="{DynamicResource Md3.SurfaceContainerHigh}">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="bodyMedium" Text="{Binding Name}" />
                      <TextBlock Classes="bodySmall"
                                 Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                                 Text="{Binding RemoteEndPoint}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </md3:Md3Card>

      </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ==================== 日志 ==================== -->
    <Border Grid.Row="2" Background="{DynamicResource Md3.SurfaceContainerLow}" Padding="24,12">
      <Grid RowDefinitions="Auto,*" Height="150">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="cardTitle" Text="运行日志" Margin="0,0,0,8" />
          <Button Grid.Column="1" Classes="text small" Content="清空"
                  Command="{Binding ClearLogsCommand}" />
        </Grid>

        <ScrollViewer Grid.Row="1">
          <ItemsControl ItemsSource="{Binding Logs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LogEntry">
                <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,1">
                  <TextBlock Classes="bodySmall" Width="74"
                             Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                             Text="{Binding TimeText}" />
                  <Border Grid.Column="1" CornerRadius="6" Padding="7,1" Margin="0,0,10,0"
                          MinWidth="46"
                          Background="{DynamicResource Md3.SurfaceContainerHighest}">
                    <TextBlock Classes="labelSmall" HorizontalAlignment="Center"
                               Text="{Binding Kind}" />
                  </Border>
                  <TextBlock Grid.Column="2" Classes="bodySmall" TextWrapping="Wrap"
                             Text="{Binding Message}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

  </Grid>
</Window>
