<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.Styling"
             x:Class="ClassShout.Classroom.App">

  <Application.Styles>
    <!--
      顺序不可颠倒：Md3 主题在后，才能覆盖 Fluent 的默认控件样式。
      PreferSystemTheme=False 让主题完全由 RequestedThemeVariant 决定，
      明暗由「设置 → 个性化」决定（跟随系统 / 浅色 / 深色），在 App 启动时应用，
    -->
    <fa:FluentAvaloniaTheme PreferSystemTheme="False" />
    <StyleInclude Source="avares://ClassShout.Design/Md3Theme.axaml" />
  </Application.Styles>

</Application>