<Project Sdk="Microsoft.NET.Sdk">

  <!--
    端到端联调工具：用真实的协议实现跑一遍完整链路，自检并返回退出码。

    为什么不用单元测试框架：这个项目要验证的是"两台机器之间的实际行为"——
    UDP 发现能不能扫到、TCP 握手对不对、音频字节有没有错位、系统 TTS 能不能出声。
    这些都是集成行为，用 xUnit 反而要额外搭一套宿主环境。做成会自检的控制台程序，
    既能进 CI（退出码判定），也能在真机上直接跑一遍确认。

    运行：dotnet run 指定本项目。加 tts 开关参数会真的用喇叭读一句中文。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ClassShout.EndToEnd</RootNamespace>
    <AssemblyName>ClassShout.EndToEnd</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ClassShout.Core\ClassShout.Core.csproj" />
    <ProjectReference Include="..\..\src\ClassShout.Classroom\ClassShout.Classroom.csproj" />
    <!-- 发送队列的"先入先出"是核心保证，直接拿来压 -->
    <ProjectReference Include="..\..\src\ClassShout.Teacher\ClassShout.Teacher.csproj" />
    <!--
      直接引用中继服务器，是为了能压 MessageQueue 的并发不变量。
      长轮询里"检查历史"与"登记等待者"之间的丢唤醒窗口只有几百纳秒，
      走 HTTP 根本撞不上 —— 只能把那个类拿到进程内来打。
    -->
    <ProjectReference Include="..\..\src\ClassShout.RelayServer\ClassShout.RelayServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      显式提升 Tmds.DBus.Protocol（Avalonia.Desktop → Avalonia.X11 的传递依赖）。

      NuGet 默认解析到 0.21.2，而该版本命中 GHSA-xrw6-gwf8-vvr9 / CVE-2026-39959
      （High）：恶意 D-Bus 对端可以伪造信号、耗尽文件描述符并造成拒绝服务。
      Linux 桌面下这是真实可达的攻击面 —— 客户端的 Linux 支持正是靠这个后端。

      选 0.21.3 而不是最新的 0.9x：它是同一小版本线上的补丁，
      Avalonia 11.3 的 X11 后端就是对着 0.21 的 API 写的，
      跨大版本强升会带来运行时不兼容，而我们恰恰要用这条路径。
    -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="$(TmdsDBusProtocolVersion)" />
  </ItemGroup>

</Project>