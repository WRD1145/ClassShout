<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    保持 NuGet 默认行为：包缓存在用户级目录（%UserProfile%\.nuget\packages）。
    这里显式清空并重声明，是为了避免开发机上其他层级的 NuGet.config
    引入不确定的包源，保证 CI 与本机行为一致。
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
